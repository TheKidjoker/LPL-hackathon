# Copy to .env.local. Leave VITE_API_URL empty to use mock data.
VITE_API_URL=
# Live API sign-in (from `python scripts/create_demo_users.py`). Without these the app sends
# only X-Role, which the deployed API rejects. Keep the password in .env.local, never commit it.
VITE_COGNITO_CLIENT_ID=
VITE_DEMO_PASSWORD=
